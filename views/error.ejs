<%- include('partials/head', { title }) %>

<main class="auth">
  <%- include('partials/auth-aside', {
        heading: 'Something needs attention.',
        lede: 'The page you asked for could not be shown.'
      }) %>

  <div class="auth__panel">
    <div class="auth__card">
      <div class="pill pill--muted" style="margin-bottom:.7rem">Error <%= status %></div>
      <h1 class="auth__title"><%= title %></h1>
      <p class="auth__lede"><%= message %></p>

      <% if (typeof detail !== 'undefined' && detail) { %>
        <details class="tableview">
          <summary>Technical details</summary>
          <pre style="white-space:pre-wrap;word-break:break-word;font-size:.72rem;
                      background:var(--surface-sunken);padding:.7rem;border-radius:var(--radius-xs);
                      border:1px solid var(--border);overflow-x:auto;margin-top:.5rem;
                      font-family:ui-monospace,Consolas,monospace;"><%= detail %></pre>
        </details>
      <% } %>

      <div class="btn-row" style="margin-top:1.3rem">
        <% if (typeof user !== 'undefined' && user) { %>
          <a href="/" class="btn">Back to my dashboard</a>
        <% } else { %>
          <a href="/login" class="btn">Go to sign in</a>
        <% } %>
      </div>
    </div>
  </div>
</main>

<%- include('partials/foot') %>
