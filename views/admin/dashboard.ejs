<%- include('../partials/head', { title }) %>
<%
  const nav = [
    { key: 'home', href: '/admin', label: 'Overview', icon: '■' }
  ];
  const total = attendanceSummary.total || 0;
  const att   = attendanceSummary.attended || 0;
  const rate  = total > 0 ? (att / total) * 100 : 0;
  const t     = viz.tone(rate);
%>

<div class="layout">
  <%- include('../partials/sidebar', {
        initials: 'HD',
        name: user ? user.username : 'Administrator',
        subtitle: admin.department_name || 'Department not set',
        active, links: nav
      }) %>

  <main class="main">
    <div class="page-head">
      <div>
        <h1>Department overview</h1>
        <div class="sub"><%= admin.department_name || 'Department not set' %></div>
      </div>
    </div>

    <div class="grid grid--hero">
      <div class="card" style="margin:0">
        <div class="hero">
          <div class="hero__label">Department attendance</div>
          <div class="hero__value hero__value--<%= t %>"><%= rate.toFixed(1) %>%</div>
          <div class="hero__note"><%= att %> of <%= total %> records attended</div>
          <div class="hero__meter"><%- viz.meter(rate, { height: 10 }) %></div>
        </div>
      </div>

      <div class="card" style="margin:0">
        <div class="card__head">
          <h2>Students by attendance band</h2>
          <span class="card__note"><%= trackedCount %> with records</span>
        </div>
        <% if (!trackedCount) { %>
          <div class="empty" style="padding:1.6rem 1rem">
            <span class="empty__icon" aria-hidden="true">&#128202;</span>
            No attendance recorded in this department yet.
          </div>
        <% } else { %>
          <%- viz.columnChart(bands, { yLabel: 'Students' }) %>
        <% } %>
      </div>
    </div>

    <div class="grid grid--4">
      <div class="stat">
        <div class="stat__label">Students</div>
        <div class="stat__value"><%= counts.students %></div>
      </div>
      <div class="stat">
        <div class="stat__label">Professors</div>
        <div class="stat__value"><%= counts.professors %></div>
      </div>
      <div class="stat">
        <div class="stat__label">Courses</div>
        <div class="stat__value"><%= counts.courses %></div>
      </div>
      <div class="stat">
        <div class="stat__label">Below 75%</div>
        <div class="stat__value <%= atRisk.length ? 'stat__value--critical' : 'stat__value--good' %>"><%= atRisk.length %></div>
        <div class="stat__note">of <%= trackedCount %> tracked</div>
      </div>
    </div>

    <!-- The one list a HoD actually acts on -->
    <div class="card">
      <div class="card__head">
        <h2>Students below the 75% requirement</h2>
        <span class="card__note">Lowest first</span>
      </div>
      <% if (!atRisk.length) { %>
        <div class="empty">
          <span class="empty__icon" aria-hidden="true">&#10003;</span>
          <% if (trackedCount) { %>
            Every student with records is at or above 75%.
          <% } else { %>
            No attendance recorded yet.
          <% } %>
        </div>
      <% } else { %>
        <%- viz.meterList(atRisk.map(function (s) {
              return {
                name: s.first_name + ' ' + (s.last_name || ''),
                sub: s.enrollment_no + (s.semester_name ? ' · ' + s.semester_name : ''),
                pct: s.pct,
                detail: s.attended + ' / ' + s.total + ' classes'
              };
            }), { nameLabel: 'Student', valueLabel: 'Attended' }) %>
      <% } %>
    </div>

    <div class="card">
      <div class="card__head">
        <h2>All students</h2>
        <span class="card__note"><%= students.length %> enrolled</span>
      </div>
      <% if (!students.length) { %>
        <div class="empty"><span class="empty__icon" aria-hidden="true">&#128101;</span>No students in this department.</div>
      <% } else { %>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Enrollment</th><th>Name</th><th>Semester</th>
                <th class="num">Attended</th><th class="num">Classes</th>
                <th style="width:150px">Attendance</th>
              </tr>
            </thead>
            <tbody>
              <% students.forEach(function (s) {
                   const p = s.total > 0 ? (s.attended / s.total) * 100 : 0; %>
                <tr>
                  <td><%= s.enrollment_no %></td>
                  <td class="cell-strong"><%= s.first_name %> <%= s.last_name || '' %></td>
                  <td><%= s.semester_name || '-' %></td>
                  <td class="num"><%= s.attended %></td>
                  <td class="num"><%= s.total %></td>
                  <td>
                    <% if (s.total > 0) { %>
                      <span class="mlist__pct"><%= p.toFixed(1) %>%</span>
                      <%- viz.meter(p, { height: 6 }) %>
                    <% } else { %>
                      <span class="pill pill--muted">No records</span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <div class="grid grid--2">
      <div class="card" style="margin:0">
        <div class="card__head"><h2>Courses</h2></div>
        <% if (!courses.length) { %>
          <div class="empty"><span class="empty__icon" aria-hidden="true">&#128214;</span>No courses.</div>
        <% } else { %>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Code</th><th>Course</th><th class="num">Credits</th><th>Taught by</th></tr></thead>
              <tbody>
                <% courses.forEach(function (c) { %>
                  <tr>
                    <td><span class="pill pill--brand"><%= c.course_code %></span></td>
                    <td class="cell-strong"><%= c.course_name %></td>
                    <td class="num"><%= c.credit_hours %></td>
                    <td class="cell-sub"><%= c.taught_by %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

      <div class="card" style="margin:0">
        <div class="card__head"><h2>Professors</h2></div>
        <% if (!professors.length) { %>
          <div class="empty"><span class="empty__icon" aria-hidden="true">&#128100;</span>No professors.</div>
        <% } else { %>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Name</th><th>Username</th><th class="num">Courses</th></tr></thead>
              <tbody>
                <% professors.forEach(function (p) { %>
                  <tr>
                    <td>
                      <span class="cell-strong"><%= p.first_name %> <%= p.last_name || '' %></span>
                      <div class="cell-sub"><%= p.email || '' %></div>
                    </td>
                    <td><%= p.username %></td>
                    <td class="num"><%= p.course_count %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </main>
</div>

<%- include('../partials/foot') %>
