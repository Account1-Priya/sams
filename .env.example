# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in your own values.
# .env is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# Port the app listens on
PORT=3000

NODE_ENV=development

# Signs the session cookie. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# OPTION A - Supabase (what you will use for real)
# ---------------------------------------------------------------------------
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
#
# Use the "Session pooler" entry. The direct db.<ref>.supabase.co host is
# IPv6-only unless you have the IPv4 add-on, which usually fails from home
# networks. The pooler host looks like aws-0-<region>.pooler.supabase.com
#
# DATABASE_URL=postgresql://postgres.<project-ref>:<your-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DATABASE_SSL=true

# ---------------------------------------------------------------------------
# OPTION B - local test database (no cloud account needed)
# ---------------------------------------------------------------------------
# Run "npm run devdb" in a second terminal, then use these two lines:
DATABASE_URL=postgresql://postgres@127.0.0.1:55432/postgres
DATABASE_SSL=false
